{
  "name": "KAORI Development",
  "dockerComposeFile": [
    "../compose.yml",
    "compose.devcontainer.yml"
  ],
  "service": "workspace",
  "runServices": [
    "workspace",
    "db",
    "redis",
    "db-first-run",
    "inventory-worker",
    "registry-security-worker",
    "maintenance-worker",
    "validation-worker",
    "runtime-worker",
    "analytics-worker",
    "reports-worker",
    "forecasting-worker",
    "resolver-execution-worker",
    "resolver-maintenance-worker",
    "beat"
  ],
  "workspaceFolder": "/workspace/kaori",
  "shutdownAction": "none",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "KAORI Flask",
      "onAutoForward": "openBrowser"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.23.2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "monosans.djlint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false,
        "files.eol": "\n"
      }
    }
  },
  "initializeCommand": [
    "docker",
    "run",
    "--rm",
    "--mount",
    "type=bind,source=${localWorkspaceFolder},target=/workspace",
    "--mount",
    "type=volume,source=kaori-dev_kaori_postgres_data,target=/pgdata,readonly",
    "-e",
    "KAORI_DEV_DOCKER_INIT=1",
    "python:3.12-alpine",
    "python",
    "/workspace/.devcontainer/prepare-postgres-env.py"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
