# ============================================================
# KAORI development environment
# Copy this file to .env before opening the Dev Container.
# Never commit the resulting .env file.
# ============================================================

APP_ENV=development
APP_VERSION=1.0.0
# Optional immutable build metadata exposed in General > System Information.
APP_BUILD_SHA=
APP_BUILD_DATE=

SECRET_KEY=replace-with-a-random-development-secret

# Docker Compose infrastructure.
POSTGRES_DB=kaori
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery uses dedicated Redis logical databases for queue and task results.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_VISIBILITY_TIMEOUT_SECONDS=10800
CELERY_WORKER_CONCURRENCY=1
CELERY_LOG_LEVEL=INFO
CELERY_BEAT_LOG_LEVEL=INFO
CLUSTER_SYNC_LOCK_TTL_SECONDS=10800
CLUSTER_SYNC_COMPLETED_TTL_SECONDS=300

# Use Docker service names inside the Dev Container.
DATABASE_URL=postgresql://postgres:replace-with-a-local-development-password@db:5432/kaori

DB_WAIT_ATTEMPTS=30
DB_WAIT_INTERVAL_SECONDS=2

# Bootstrap only.
# Run: flask --app run:app bootstrap-admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Database login is always available as the break-glass provider.
AUTH_ADDITIONAL_PROVIDERS=

# Shared rate-limit storage for container development.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://redis:6379/2
AUTH_LOGIN_RATE_LIMIT=5 per minute
AUTH_LOGIN_RATE_LIMIT_MESSAGE=Too many login attempts. Please wait a minute and try again.

# Protected Kubernetes Secret reveal is default-deny. Per-cluster policy and a
# dedicated reveal kubeconfig are also required before a value can be read.
KUBERNETES_SECRET_REVEAL_ENABLED=false
KUBERNETES_SECRET_REVEAL_RATE_LIMIT=3 per 5 minutes
KUBERNETES_SECRET_REVEAL_STEP_UP_TTL_SECONDS=300
KUBERNETES_SECRET_REVEAL_WINDOW_SECONDS=15
KUBERNETES_SECRET_REVEAL_MAX_BYTES=65536
KUBERNETES_SECRET_REVEAL_APPROVAL_TTL_MINUTES=10
KUBERNETES_SECRET_REVEAL_PENDING_TTL_HOURS=24

# Reports storage.
REPORT_STORAGE_BACKEND=local
REPORT_LOCAL_STORAGE_DIR=instance
REPORT_RENDER_STAGING_DIR=instance/report-render-staging
REPORT_DOWNLOAD_CACHE_DIR=instance/report-download-cache
REPORT_RETENTION_DAYS=90

# Optional S3-compatible report storage.
REPORT_S3_BUCKET=
REPORT_S3_REGION=us-east-1
REPORT_S3_ACCESS_KEY_ID=
REPORT_S3_SECRET_ACCESS_KEY=
REPORT_S3_ENDPOINT_URL=
REPORT_S3_PREFIX=
REPORT_S3_FORCE_PATH_STYLE=false

# Celery timezone used by scheduled maintenance tasks.
CELERY_TIMEZONE=UTC
RETENTION_CELERY_QUEUE=inventory

# Reusable archive storage. Defaults can reuse the report storage backend,
# while these values allow archive data to use a separate Local/S3 location.
ARCHIVE_STORAGE_BACKEND=local
ARCHIVE_LOCAL_STORAGE_DIR=instance
ARCHIVE_DOWNLOAD_CACHE_DIR=instance/archive-download-cache
ARCHIVE_STAGING_DIR=instance/archive-staging
ARCHIVE_OBJECT_PREFIX=archives
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_ENDPOINT_URL=
ARCHIVE_S3_PREFIX=
ARCHIVE_S3_FORCE_PATH_STYLE=false

# Operational Activity archive-first retention.
ACTIVITY_RETENTION_ENABLED=true
ACTIVITY_RETENTION_DAYS=90
ACTIVITY_ARCHIVE_RETENTION_DAYS=365
ACTIVITY_RETENTION_BATCH_SIZE=5000
ACTIVITY_RETENTION_PROTECT_UNREVIEWED=false
ACTIVITY_RETENTION_PROTECTED_MAX_DAYS=180
ACTIVITY_RETENTION_SCHEDULE_ENABLED=true
ACTIVITY_RETENTION_SCHEDULE_HOUR=2
ACTIVITY_RETENTION_SCHEDULE_MINUTE=15
ARCHIVE_SCHEDULED_DOMAINS=operational_activity

# External identity provider secrets are referenced by name from the database
# provider configuration. Example: set Bind Password Environment Variable to
# KAORI_LDAP_BIND_PASSWORD, then provide the secret here or through the runtime
# secret manager. Never place the password itself in the database field.
# KAORI_LDAP_BIND_PASSWORD=

# Google and GitHub SSO client secrets. Identity-provider records store only these variable names.
KAORI_GOOGLE_CLIENT_SECRET=
KAORI_GITHUB_CLIENT_SECRET=

# Shared integration runtime monitoring
INTEGRATION_RUNTIME_MONITORING_ENABLED=true
INTEGRATION_RUNTIME_MONITORING_INTERVAL_MINUTES=5
INTEGRATION_RUNTIME_CELERY_QUEUE=inventory
INTEGRATION_VALIDATION_CELERY_QUEUE=integration-validation
INTEGRATION_VALIDATION_LOCK_TTL_SECONDS=7200
INTEGRATION_VALIDATION_WORKER_CONCURRENCY=1
