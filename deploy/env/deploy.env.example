# KAORI deployment-adapter configuration for governed server Docker Compose.
# This file is not part of the portable Flask/Celery application contract.
# Keep image references immutable and digest-qualified.

KAORI_APP_ENV_FILE=/etc/kaori/app.env
KAORI_SECRETS_ENV_FILE=/etc/kaori/secrets.env
KAORI_POSTGRES_ADMIN_ENV_FILE=/etc/kaori/postgres-admin.env
KAORI_POSTGRES_MIGRATION_ENV_FILE=/etc/kaori/postgres-migrate.env
KAORI_ACTIVE_RELEASE_ENV_FILE=/var/lib/kaori/deploy-state/release.env

POSTGRES_DB=kaori
POSTGRES_USER=kaori

# Permit guarded first-run role/admin bootstrap only on a verified empty DB.
# Disable after initial UAT admission. Never resets a populated volume.
KAORI_BUNDLED_FRESH_BOOTSTRAP=false

# One-time explicitly governed ownership cutover for populated legacy databases.
# Requires a verified backup; leave disabled during ordinary deployment.
KAORI_BUNDLED_SCHEMA_CUTOVER=false

KAORI_POSTGRES_IMAGE=
KAORI_REDIS_IMAGE=

