# KAORI deployment-adapter configuration for the VPS Docker Compose runtime.
# This file is not part of the portable Flask/Celery application contract.
# Keep image references immutable and digest-qualified.

KAORI_APP_ENV_FILE=/etc/kaori/app.env
KAORI_SECRETS_ENV_FILE=/etc/kaori/secrets.env
KAORI_ACTIVE_RELEASE_ENV_FILE=/var/lib/kaori/deploy-state/release.env

POSTGRES_DB=kaori
POSTGRES_USER=kaori

KAORI_POSTGRES_IMAGE=
KAORI_REDIS_IMAGE=

# KAORI uses this only to verify public application readiness through the
# independently managed shared edge. Ingress/TLS settings live under /opt/shared-edge.
KAORI_PUBLIC_DOMAIN=kaori.cloud
