# KAORI portable application configuration.
# This file defines how KAORI behaves, independent of Docker Compose, systemd,
# Kubernetes, Nomad, or another runtime adapter. Do not store credentials here.

APP_ENV=production
KAORI_PUBLIC_BASE_URL=https://kaori.cloud
TRUSTED_HOSTS=kaori.cloud,localhost

PROXY_FIX_ENABLED=true
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1
PROXY_FIX_X_PREFIX=0

CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_VISIBILITY_TIMEOUT_SECONDS=18000
CELERY_LOG_LEVEL=INFO
CELERY_BEAT_LOG_LEVEL=INFO
CELERY_TIMEZONE=UTC
INVENTORY_WORKER_CONCURRENCY=2
INVENTORY_WORKER_PREFETCH_MULTIPLIER=1
INVENTORY_MAX_TASKS_PER_CHILD=50
RETENTION_CELERY_QUEUE=maintenance
RETENTION_RETRY_DELAY_SECONDS=60

INTEGRATION_VALIDATION_CELERY_QUEUE=integration-validation
INTEGRATION_VALIDATION_LOCK_TTL_SECONDS=7200
INTEGRATION_VALIDATION_WORKER_CONCURRENCY=1
INTEGRATION_VALIDATION_MAX_TASKS_PER_CHILD=100
INTEGRATION_VALIDATION_WORKER_CPU_LIMIT=2.0
INTEGRATION_VALIDATION_WORKER_MEMORY_LIMIT=2g
CLUSTER_SYNC_LOCK_TTL_SECONDS=10800
CLUSTER_SYNC_COMPLETED_TTL_SECONDS=300

RATELIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=5 per minute
AUTH_LOGIN_RATE_LIMIT_MESSAGE=Too many login attempts. Please wait a minute and try again.
AUTH_SSO_RATE_LIMIT=20 per minute
AUTH_SSO_RATE_LIMIT_MESSAGE=Too many SSO attempts. Please wait a minute and start sign-in again.
AUTH_SSO_FLOW_TTL_SECONDS=600
AUTH_REMEMBER_ME_DAYS=7
AUTH_ALLOW_SUPER_ADMIN_REMEMBER_ME=false
AUTH_LDAP_ALLOW_PLAINTEXT=false

KUBERNETES_SECRET_REVEAL_ENABLED=false
KUBERNETES_SECRET_REVEAL_RATE_LIMIT=3 per 5 minutes
KUBERNETES_SECRET_REVEAL_STEP_UP_TTL_SECONDS=300
KUBERNETES_SECRET_REVEAL_WINDOW_SECONDS=15
KUBERNETES_SECRET_REVEAL_MAX_BYTES=65536
KUBERNETES_SECRET_REVEAL_APPROVAL_TTL_MINUTES=10
KUBERNETES_SECRET_REVEAL_PENDING_TTL_HOURS=24
TLS_CERTIFICATE_RENEWAL_WINDOW_DAYS=30
TLS_CERTIFICATE_CRITICAL_WINDOW_DAYS=7

WAIT_FOR_DB=true
DB_WAIT_ATTEMPTS=30
DB_WAIT_INTERVAL_SECONDS=2

REPORT_SCHEDULE_TIMEZONE=Asia/Jakarta
REPORT_PDF_CLASSIFICATION=Internal
REPORT_STORAGE_BACKEND=s3
REPORT_LOCAL_STORAGE_DIR=/app/instance
REPORT_RENDER_STAGING_DIR=/app/instance/report-render-staging
REPORT_DOWNLOAD_CACHE_DIR=/app/instance/report-download-cache
REPORT_S3_BUCKET=kaori-production
REPORT_S3_REGION=us-east-1
REPORT_S3_ENDPOINT_URL=
REPORT_S3_PREFIX=kaori/reports
REPORT_S3_FORCE_PATH_STYLE=false
REPORT_S3_CONNECT_TIMEOUT_SECONDS=2
REPORT_S3_READ_TIMEOUT_SECONDS=3
REPORT_S3_MAX_ATTEMPTS=1
REPORT_STORAGE_STATUS_CACHE_SECONDS=15
REPORT_STORAGE_HEALTH_MONITOR_ENABLED=true
REPORT_STORAGE_HEALTH_INTERVAL_MINUTES=1
REPORT_STORAGE_HEALTH_STALE_SECONDS=120
REPORT_STORAGE_HEALTH_STATE_TTL_SECONDS=600
REPORT_STORAGE_HEALTH_CELERY_QUEUE=maintenance
REPORT_RETENTION_DAYS=90
REPORT_ARCHIVE_RETENTION_DAYS=180
REPORT_ORPHAN_DETECTION_ENABLED=true

ARCHIVE_DOWNLOAD_CACHE_DIR=/app/instance/archive-download-cache
ARCHIVE_STAGING_DIR=/app/instance/archive-staging
ARCHIVE_OBJECT_PREFIX=archives
ARCHIVE_PURGE_BATCH_SIZE=250
DATA_LIFECYCLE_SCHEDULER_ENABLED=true
ARCHIVE_SCHEDULED_DOMAINS=operational_activity,job_execution,runtime_observation,analytics_snapshot,generated_report

ACTIVITY_RETENTION_ENABLED=true
ACTIVITY_RETENTION_DAYS=90
ACTIVITY_ARCHIVE_RETENTION_DAYS=365
ACTIVITY_RETENTION_BATCH_SIZE=5000
ACTIVITY_RETENTION_PROTECT_UNREVIEWED=false
ACTIVITY_RETENTION_PROTECTED_MAX_DAYS=180
ACTIVITY_RETENTION_SCHEDULE_ENABLED=true
ACTIVITY_RETENTION_SCHEDULE_HOUR=2
ACTIVITY_RETENTION_SCHEDULE_MINUTE=15

JOB_EXECUTION_RETENTION_ENABLED=true
JOB_EXECUTION_RETENTION_DAYS=90
JOB_EXECUTION_ARCHIVE_RETENTION_DAYS=365
JOB_EXECUTION_RETENTION_BATCH_SIZE=2500
JOB_EXECUTION_RUNTIME_RETENTION_DAYS=30
JOB_EXECUTION_VALIDATION_RETENTION_DAYS=30
JOB_EXECUTION_ANALYTICS_RETENTION_DAYS=90
JOB_EXECUTION_FORECASTING_RETENTION_DAYS=180
JOB_EXECUTION_FAILED_RETENTION_DAYS=90
JOB_EXECUTION_RETENTION_SCHEDULE_HOUR=3
JOB_EXECUTION_RETENTION_SCHEDULE_MINUTE=0

RUNTIME_OBSERVATION_RETENTION_ENABLED=true
RUNTIME_OBSERVATION_RETENTION_DAYS=90
RUNTIME_OBSERVATION_ARCHIVE_RETENTION_DAYS=365
RUNTIME_OBSERVATION_RETENTION_BATCH_SIZE=5000
RUNTIME_OBSERVATION_RETENTION_SCHEDULE_HOUR=3
RUNTIME_OBSERVATION_RETENTION_SCHEDULE_MINUTE=45
ANALYTICS_SNAPSHOT_RETENTION_ENABLED=true
ANALYTICS_SNAPSHOT_RETENTION_DAYS=30
ANALYTICS_SNAPSHOT_ARCHIVE_RETENTION_DAYS=180
ANALYTICS_SNAPSHOT_RETENTION_BATCH_SIZE=5000
ANALYTICS_SNAPSHOT_RETENTION_SCHEDULE_HOUR=4
ANALYTICS_SNAPSHOT_RETENTION_SCHEDULE_MINUTE=15

GENERATED_REPORT_RETENTION_ENABLED=false
GENERATED_REPORT_RETENTION_DAYS=90
GENERATED_REPORT_ARCHIVE_RETENTION_DAYS=365
GENERATED_REPORT_RETENTION_BATCH_SIZE=250
GENERATED_REPORT_FAILED_RETENTION_DAYS=30
GENERATED_REPORT_ARCHIVED_RETENTION_DAYS=180
GENERATED_REPORT_RETENTION_SCHEDULE_HOUR=5
GENERATED_REPORT_RETENTION_SCHEDULE_MINUTE=0

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info

ADMIN_USERNAME=super
ADMIN_EMAIL=admin@example.com

INTEGRATION_RUNTIME_MONITORING_ENABLED=true
INTEGRATION_RUNTIME_MONITORING_INTERVAL_MINUTES=5
INTEGRATION_RUNTIME_CELERY_QUEUE=integration-runtime
INTEGRATION_RUNTIME_WORKER_CONCURRENCY=4
INTEGRATION_RUNTIME_MAX_TASKS_PER_CHILD=500
INTEGRATION_RUNTIME_WORKER_CPU_LIMIT=1.0
INTEGRATION_RUNTIME_WORKER_MEMORY_LIMIT=1g

ANALYTICS_CELERY_QUEUE=analytics-batch
ANALYTICS_TASK_SOFT_TIME_LIMIT_SECONDS=900
ANALYTICS_TASK_HARD_TIME_LIMIT_SECONDS=960
ANALYTICS_TASK_MAX_SOFT_TIME_LIMIT_SECONDS=7200
ANALYTICS_DATASET_TIMEOUT_SECONDS=300
ANALYTICS_SOURCE_LOCK_TIMEOUT_SECONDS=900
ANALYTICS_WORKER_CONCURRENCY=2
ANALYTICS_MAX_TASKS_PER_CHILD=50
ANALYTICS_WORKER_CPU_LIMIT=2.0
ANALYTICS_WORKER_MEMORY_LIMIT=2g

FORECASTING_CELERY_QUEUE=forecasting
FORECASTING_TASK_SOFT_TIME_LIMIT_SECONDS=2700
FORECASTING_TASK_HARD_TIME_LIMIT_SECONDS=2760
FORECASTING_TASK_MAX_SOFT_TIME_LIMIT_SECONDS=14400
FORECASTING_DATASET_TIMEOUT_SECONDS=600
FORECASTING_WORKER_CONCURRENCY=1
FORECASTING_MAX_TASKS_PER_CHILD=10
FORECASTING_WORKER_CPU_LIMIT=2.0
FORECASTING_WORKER_MEMORY_LIMIT=3g

METRICS_SOURCE_ANALYTICS_QUERY_TIMEOUT_SECONDS=30
METRICS_SOURCE_ANALYTICS_RANGE_QUERY_TIMEOUT_SECONDS=120
METRICS_SOURCE_ANALYTICS_QUERY_RETRIES=2
METRICS_SOURCE_ANALYTICS_RETRY_BACKOFF_SECONDS=1
METRICS_RECENT_WINDOW_HOURS=24

JOB_MAINTENANCE_CELERY_QUEUE=maintenance
JOB_POLICY_SCHEDULER_ENABLED=true
JOB_MAINTENANCE_WORKER_CONCURRENCY=1
JOB_MAINTENANCE_MAX_TASKS_PER_CHILD=500
JOB_MAINTENANCE_WORKER_CPU_LIMIT=0.5
JOB_MAINTENANCE_WORKER_MEMORY_LIMIT=512m

ALERT_SIGNAL_EVALUATION_ENABLED=true
ALERT_SIGNAL_EVALUATION_INTERVAL_MINUTES=5
ALERT_SIGNAL_FRESHNESS_MINUTES=10
ALERT_INTELLIGENCE_NOTIFICATION_ENABLED=true
ALERT_INTELLIGENCE_NOTIFICATION_INTERVAL_MINUTES=1
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3

JOB_MAX_ACTIVE_PER_USER=5
JOB_MAX_HEAVY_PER_USER=1
JOB_MAX_ACTIVE_PER_RESOURCE=2
JOB_QUEUED_STALE_SECONDS=1800
JOB_RUNNING_STALE_SECONDS=7200
JOB_RECOVERY_ENABLED=true
JOB_RECOVERY_INTERVAL_MINUTES=5

OBJECT_STORAGE_INVENTORY_USAGE_STATS_MODE=disabled

AUTOMATION_EXECUTION_ENABLED=false
CUSTOM_RUNBOOK_AUTHORING_ENABLED=false
AUTOMATION_CANDIDATE_MATERIALIZATION_ENABLED=true
AUTOMATION_CANDIDATE_MATERIALIZATION_INTERVAL_MINUTES=1
AUTOMATION_LIFECYCLE_RECONCILIATION_ENABLED=true

RESOLVER_ENABLED_ACTIONS=
RESOLVER_KUBERNETES_ALLOWED_NAMESPACES=
RESOLVER_EXECUTION_CELERY_QUEUE=resolver-execution
RESOLVER_MAINTENANCE_CELERY_QUEUE=resolver-maintenance
RESOLVER_MAINTENANCE_ENABLED=true
RESOLVER_MAINTENANCE_INTERVAL_MINUTES=1
RESOLVER_EXECUTION_WORKER_CONCURRENCY=1
RESOLVER_EXECUTION_MAX_TASKS_PER_CHILD=25
RESOLVER_EXECUTION_WORKER_CPU_LIMIT=1.0
RESOLVER_EXECUTION_WORKER_MEMORY_LIMIT=1g
RESOLVER_MAINTENANCE_WORKER_CONCURRENCY=1
RESOLVER_MAINTENANCE_MAX_TASKS_PER_CHILD=500
RESOLVER_MAINTENANCE_WORKER_CPU_LIMIT=0.5
RESOLVER_MAINTENANCE_WORKER_MEMORY_LIMIT=512m

REPORTS_CELERY_QUEUE=reports
REPORTS_WORKER_CONCURRENCY=1
REPORTS_MAX_TASKS_PER_CHILD=25
REPORTS_WORKER_CPU_LIMIT=1.0
REPORTS_WORKER_MEMORY_LIMIT=1g
