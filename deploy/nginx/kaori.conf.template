# KAORI canonical host-ingress template.
# Render only through deploy/nginx/bootstrap-ingress.sh.

upstream kaori_web {
    server 127.0.0.1:5000;
    keepalive 32;
}

# Reject unexpected clear-text Host traffic before it can reach KAORI.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# Reject unexpected TLS SNI during the handshake.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# The intended hostname keeps HTTP available only for ACME and redirects the rest.
server {
    listen 80;
    listen [::]:80;
    server_name __KAORI_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root __KAORI_ACME_WEBROOT__;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://__KAORI_DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __KAORI_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__KAORI_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__KAORI_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:KAORI_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 10s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
        proxy_buffering on;
    }
}
