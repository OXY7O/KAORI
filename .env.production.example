# ============================================================
# KAORI production environment example
# Copy to .env.production only on the deployment host.
# Never commit .env.production or real credentials.
# ============================================================

# Immutable release image. Use a version or commit SHA, not only latest.
KAORI_IMAGE=ghcr.io/your-organization/kaori:v1.0.0
APP_ENV=production
APP_VERSION=1.0.0

# Generate at least 64 random characters.
SECRET_KEY=

# Public hostnames accepted by Flask, comma-separated and without scheme.
TRUSTED_HOSTS=kaori.example.com,127.0.0.1,localhost

# Keep enabled when KAORI is behind one trusted Nginx/Traefik proxy.
PROXY_FIX_ENABLED=true
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1
PROXY_FIX_X_PREFIX=0

# PostgreSQL and Redis must be production services, not development defaults.
DATABASE_URL=postgresql://kaori:replace-me@postgres.internal:5432/kaori
REDIS_URL=redis://redis.internal:6379/0

RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://redis.internal:6379/2
AUTH_LOGIN_RATE_LIMIT=5 per minute
AUTH_LOGIN_RATE_LIMIT_MESSAGE=Too many login attempts. Please wait a minute and try again.
AUTH_LOGIN_AUDIT_RETENTION_DAYS=90

WAIT_FOR_DB=true
DB_WAIT_ATTEMPTS=30
DB_WAIT_INTERVAL_SECONDS=2

# S3-compatible storage is recommended for production report artifacts.
PROD_REPORT_STORAGE_BACKEND=s3
PROD_REPORT_LOCAL_STORAGE_DIR=/app/instance
REPORT_RENDER_STAGING_DIR=/app/instance/report-render-staging
REPORT_DOWNLOAD_CACHE_DIR=/app/instance/report-download-cache
PROD_REPORT_S3_BUCKET=kaori-production
PROD_REPORT_S3_REGION=us-east-1
PROD_REPORT_S3_ACCESS_KEY_ID=
PROD_REPORT_S3_SECRET_ACCESS_KEY=
PROD_REPORT_S3_ENDPOINT_URL=
PROD_REPORT_S3_PREFIX=kaori/reports
REPORT_S3_FORCE_PATH_STYLE=false
REPORT_RETENTION_DAYS=90

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info

# Bind only to loopback when host Nginx proxies to KAORI.
KAORI_BIND_ADDRESS=127.0.0.1
KAORI_PORT=5000

# First installation only. Set temporarily, run bootstrap-admin, then remove
# ADMIN_PASSWORD from the deployment host environment file.
ADMIN_USERNAME=super
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
