# DEPRECATED: monolithic KAORI production environment example.
#
# The production configuration contract is now split by authority so the
# application settings remain portable when the deployment adapter changes.
# Use these templates instead:
#
#   deploy/env/app.env.example      -> /etc/kaori/app.env
#   deploy/env/secrets.env.example  -> /etc/kaori/secrets.env
#   deploy/env/deploy.env.example   -> /etc/kaori/deploy.env
#
# Release identity is never persisted here. Governed deployment generates:
#
#   /var/lib/kaori/deploy-state/release.env
#
# Do not create a new /etc/kaori/.env.production from this file.
