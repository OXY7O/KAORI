{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KAORI: Flask Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": [
        "--app",
        "run:app",
        "run",
        "--host=0.0.0.0",
        "--port=5000",
        "--no-reload"
      ],
      "env": {
        "APP_ENV": "development",
        "FLASK_DEBUG": "1"
      },
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "KAORI: Flask Auto Reload",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": [
        "--app",
        "run:app",
        "run",
        "--host=0.0.0.0",
        "--port=5000",
        "--debug"
      ],
      "env": {
        "APP_ENV": "development"
      },
      "jinja": true,
      "justMyCode": true,
      "subProcess": true,
      "console": "integratedTerminal"
    }
  ]
}
