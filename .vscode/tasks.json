{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KAORI: Database Upgrade",
      "type": "shell",
      "command": "flask --app run:app db upgrade",
      "problemMatcher": []
    },
    {
      "label": "KAORI: Database Current",
      "type": "shell",
      "command": "flask --app run:app db current",
      "problemMatcher": []
    },
    {
      "label": "KAORI: Seed RBAC",
      "type": "shell",
      "command": "flask --app run:app seed-rbac",
      "problemMatcher": []
    },
    {
      "label": "KAORI: Bootstrap Admin",
      "type": "shell",
      "command": "flask --app run:app bootstrap-admin",
      "problemMatcher": []
    },
    {
      "label": "KAORI: Ruff Check",
      "type": "shell",
      "command": "ruff check app tests scripts",
      "problemMatcher": []
    },
    {
      "label": "KAORI: Ruff Format",
      "type": "shell",
      "command": "ruff format app tests scripts",
      "problemMatcher": []
    },
    {
      "label": "KAORI: djLint Check",
      "type": "shell",
      "command": "djlint app/templates --check",
      "problemMatcher": []
    },
    {
