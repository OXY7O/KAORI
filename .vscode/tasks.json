      "type": "shell",
      "command": "python -m compileall app scripts",
      "problemMatcher": []
    },
    {
      "label": "KAORI: Watch Tailwind CSS",
      "type": "shell",
      "command": "npm run watch-css",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "KAORI: Build Tailwind CSS",
      "type": "shell",
      "command": "npm run build-css",
      "problemMatcher": []
    },
    {
      "label": "KAORI: Check Frontend Format",
      "type": "shell",
      "command": "npm run check-format",
      "problemMatcher": []
    }
  ]
}
