{
    "name": "kaori",
    "private": true,
    "scripts": {
        "watch-css": "tailwindcss -i ./frontend/styles.css -o ./app/static/css/output.css --watch",
        "build-css": "tailwindcss -i ./frontend/styles.css -o ./app/static/css/output.css --minify && node ./scripts/verify_css_build.mjs",
        "verify-css": "node ./scripts/verify_css_build.mjs",
        "format": "prettier . --write",
        "check-format": "prettier . --check"
    },
    "devDependencies": {
        "@tailwindcss/cli": "4.3.1",
        "prettier": "3.8.4",
        "prettier-plugin-tailwindcss": "0.8.0",
        "tailwindcss": "4.3.1"
    }
}
