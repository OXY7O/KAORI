{
  "name": "kaori",
  "private": true,
  "packageManager": "npm@10.9.9",
  "scripts": {
    "watch-css": "tailwindcss -i ./frontend/styles.css -o ./app/static/css/output.css --minify --watch=always",
    "build-css": "tailwindcss -i ./frontend/styles.css -o ./app/static/css/output.css --minify && node ./scripts/verify_css_build.mjs",
    "verify-css": "node ./scripts/verify_css_build.mjs",
    "format": "prettier \"frontend/**/*.{css,js}\" \"app/static/js/**/*.js\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"package*.json\" --write",
    "check-format": "prettier \"frontend/**/*.{css,js}\" \"app/static/js/**/*.js\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"package*.json\" --check",
    "vendor-assets": "node ./scripts/vendor_frontend_assets.mjs",
    "verify-vendor-assets": "node ./scripts/verify_frontend_assets.mjs",
    "build-frontend": "npm run vendor-assets && npm run build-css",
    "verify-frontend": "npm run verify-vendor-assets && npm run verify-css",
    "prepare-frontend": "npm run build-frontend && npm run verify-frontend",
    "bootstrap-frontend": "bash ./scripts/bootstrap_frontend_assets.sh"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.4",
    "alpinejs": "3.17.5",
    "chart.js": "4.6.1",
    "htmx.org": "2.0.11",
    "lucide": "1.69.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
