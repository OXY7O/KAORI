+ROOT = Path(__file__).resolve().parents[1]
+
+REQUIRED = (
+    'app/platform_operations/data_lifecycle/__init__.py',
+    'app/platform_operations/data_lifecycle/routes.py',
+    'app/platform_operations/data_lifecycle/service.py',
