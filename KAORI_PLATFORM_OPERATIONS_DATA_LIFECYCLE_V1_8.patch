+{% extends "layouts/app.html" %}
+{% import "components/page_hero.html" as page_hero %}
+{% import "components/table_label.html" as table_label %}
+{% import "components/framed_workspace_tabs.html" as framed_workspace_tabs %}
+{% block title %}Data Lifecycle · KAORI{% endblock %}
+{% block dashboard_content %}
+    <div class="space-y-6"
+         x-data="{ tabs: ['policies', 'storage', 'history'], activeTab: '{{ lifecycle.active_tab }}', activeDomain: '{{ lifecycle.selected_domain }}', domainSearch: '', setTab(tab) { if (!this.tabs.includes(tab)) return; this.activeTab = tab; const url = new URL(window.location.href); url.searchParams.set('tab', tab); if (this.activeDomain) url.searchParams.set('domain', this.activeDomain); window.history.replaceState({}, '', url); }, moveTab(currentTab, direction, prefix = 'data-lifecycle') { const currentIndex = this.tabs.indexOf(currentTab); if (currentIndex < 0) return; let nextIndex = currentIndex; if (direction === 'home') nextIndex = 0; else if (direction === 'end') nextIndex = this.tabs.length - 1; else nextIndex = (currentIndex + direction + this.tabs.length) % this.tabs.length; const nextTab = this.tabs[nextIndex]; this.setTab(nextTab); this.$nextTick(() => document.getElementById(`${prefix}-tab-${nextTab}`)?.focus()); } }">
+        <section class="{{ page_hero.shell_classes() }}">
+            <div class="{{ page_hero.layout_classes() }}">
+                <div class="{{ page_hero.content_classes() }}">
+                    {% call page_hero.intro('archive-restore', 'Platform Operations', 'database-zap') %}
+                        <h1 class="{{ page_hero.title_classes() }}">Data Lifecycle</h1>
+                        <p class="mt-2 {{ page_hero.description_classes() }}">Govern retention, verified archives, and safe cleanup across KAORI operational data domains.</p>
+                        <div class="{{ page_hero.metadata_row_classes() }}">
+                            {{ page_hero.meta_label('database', lifecycle.managed_domain_count ~ ' Managed Domains') }}
+                            {{ page_hero.meta_label('shield-check', lifecycle.enabled_domain_count ~ ' Policies Enabled') }}
+                            {{ page_hero.meta_label('archive', lifecycle.active_archive_total ~ ' Active Archives') }}
+                        </div>
+                    {% endcall %}
+                </div>
+                <aside class="{{ page_hero.aside_classes() }}" aria-label="Data lifecycle posture">
+                    <div class="{{ page_hero.context_panel_classes() }}">
+                        {{ page_hero.context_header('Lifecycle Control Plane', 'Archive-First Governance', 'archive-restore') }}
+                        <div class="{{ page_hero.context_panel_metrics_classes() }}">
+                            {{ page_hero.context_metric('database', 'Managed Domains', lifecycle.managed_domain_count, 'Registered archive adapters') }}
+                            {{ page_hero.context_metric('hard-drive', 'Archive Storage', lifecycle.storage.status_label, 'Shared verified destination') }}
+                        </div>
+                        {{ page_hero.context_info('shield-check', 'Cleanup begins only after archive and manifest verification.') }}
+                    </div>
+                </aside>
+            </div>
+        </section>
+
+        <section class="overflow-hidden rounded-2xl border border-outline-default bg-surface-card shadow-sm">
+            {{ framed_workspace_tabs.render([('policies', 'Retention Policies', 'sliders-horizontal'), ('storage', 'Archive Storage', 'hard-drive'), ('history', 'Archive History', 'history')], prefix='data-lifecycle', aria_label='Data Lifecycle Workspaces') }}
+            <div class="p-5 lg:p-6">
+                <div id="data-lifecycle-panel-policies"
+                     role="tabpanel"
+                     x-show="activeTab === 'policies'"
+                     x-cloak>
+                    <div class="grid gap-6 xl:grid-cols-12 xl:items-start">
+                        <aside class="space-y-3 xl:col-span-4">
+                            <div class="rounded-xl border border-outline-default bg-surface-card p-3">
+                                <label class="text-xs font-semibold text-content-secondary">Search Data Domains</label>
+                                <div class="relative mt-2">
+                                    <i data-lucide="search" class="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-content-muted"></i>
+                                    <input type="search"
+                                           x-model.debounce.200ms="domainSearch"
+                                           class="h-9 w-full rounded-md border border-outline-default bg-surface-card pl-9 pr-3 text-xs text-content-primary outline-none focus:border-kaori-primary focus:ring-2 focus:ring-kaori-accent/30"
+                                           placeholder="Audit, jobs, runtime…">
+                                </div>
+                                <p class="mt-2 text-xs leading-4 text-content-muted">Only domains with an approved archive adapter and cleanup boundary are manageable.</p>
+                            </div>
+
+                            <div class="max-h-[580px] space-y-3 overflow-y-auto pr-1">
+                                {% for domain in lifecycle.domains %}
+                                    <a href="{{ url_for('platform_operations.data_lifecycle.index', tab='policies', domain=domain.name) }}"
+                                       data-domain-search="{{ (domain.label ~ ' ' ~ domain.description ~ ' ' ~ domain.name)|lower }}"
+                                       x-show="!domainSearch || $el.dataset.domainSearch.includes(domainSearch.toLowerCase())"
+                                       hx-get="{{ url_for('platform_operations.data_lifecycle.index', tab='policies', domain=domain.name) }}"
+                                       hx-target="#data-lifecycle-domain-workspace"
+                                       hx-push-url="true"
+                                       @click="activeDomain='{{ domain.name }}'"
+                                       class="block rounded-xl border p-4 transition-colors"
+                                       :class="activeDomain === '{{ domain.name }}' ? 'border-kaori-primary bg-kaori-soft' : 'border-outline-default bg-surface-card hover:border-outline-strong hover:bg-surface-hover'">
+                                        <div class="flex items-start gap-3">
+                                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-kaori-soft text-kaori-primary dark:text-kaori-accent"><i data-lucide="{{ domain.icon }}" class="h-5 w-5"></i></span>
+                                            <div class="min-w-0 flex-1">
+                                                <div class="flex items-center justify-between gap-3">
+                                                    <p class="text-sm font-semibold text-content-primary">{{ domain.label }}</p>
+                                                    {{ table_label.status_label('Enabled' if domain.enabled else 'Disabled', 'normal' if domain.enabled else 'disabled') }}
+                                                </div>
+                                                <p class="mt-1 text-xs leading-5 text-content-secondary">{{ domain.description }}</p>
+                                                <div class="mt-3 flex flex-wrap gap-2 text-xs font-semibold text-content-muted">
+                                                    <span>{{ domain.hot_retention_days }}d hot</span><span>•</span><span>{{ domain.eligible_count ~ ' eligible' if domain.eligible_count is not none else 'Preview available' }}</span><span>•</span><span>{{ domain.total_archives }} archives</span>
+                                                </div>
+                                            </div>
+                                        </div>
+                                    </a>
+                                {% endfor %}
+                            </div>
+
+                            <div class="rounded-xl border border-outline-default bg-surface-subtle p-4">
+                                <div class="flex items-start gap-3">
+                                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-kaori-soft text-kaori-primary dark:text-kaori-accent"><i data-lucide="list-checks" class="h-4 w-4"></i></span>
+                                    <div class="min-w-0">
+                                        <p class="text-sm font-semibold text-content-primary">Execution Boundary</p>
+                                        <p class="mt-1 text-xs leading-5 text-content-muted">Lifecycle policy and archive evidence stay here. Worker runtime, retries, and cancellation remain canonical in Jobs &amp; Executions.</p>
+                                        {% if current_user.has_permission('jobs.view') %}
+                                            <a href="{{ url_for('jobs.executions') }}" class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-kaori-primary hover:underline dark:text-kaori-accent"><i data-lucide="external-link" class="h-3.5 w-3.5"></i>Open Jobs &amp; Executions</a>
+                                        {% endif %}
+                                    </div>
+                                </div>
+                            </div>
+                        </aside>
+
+                        <main class="min-w-0 xl:col-span-8">
+                            {% include "platform_operations/data_lifecycle/partials/_domain_workspace.html" %}
+                        </main>
+                    </div>
+                </div>
+
+                <div id="data-lifecycle-panel-storage"
+                     role="tabpanel"
+                     x-show="activeTab === 'storage'"
+                     x-cloak>
+                    {% include "platform_operations/data_lifecycle/partials/_storage.html" %}
+                </div>
+
+                <div id="data-lifecycle-panel-history"
+                     role="tabpanel"
+                     x-show="activeTab === 'history'"
+                     x-cloak>
+                    {% include "platform_operations/data_lifecycle/partials/_history.html" %}
+                </div>
+            </div>
+        </section>
+    </div>
+{% endblock dashboard_content %}
