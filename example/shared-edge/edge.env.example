# Standalone public-edge example configuration.
# Copy to /opt/shared-edge/config/edge.env.
# This file is independent from /etc/kaori/*.

EDGE_NGINX_IMAGE=
EDGE_CERTBOT_IMAGE=
EDGE_LETSENCRYPT_EMAIL=
EDGE_PUBLIC_IP=

EDGE_SITES_DIR=/opt/shared-edge/config/sites
EDGE_CERTIFICATE_DIR=/opt/shared-edge/state/letsencrypt
EDGE_ACME_WEBROOT_DIR=/opt/shared-edge/state/acme-webroot

EDGE_RELOAD_INTERVAL_SECONDS=30
EDGE_CERTBOT_RENEW_INTERVAL_SECONDS=43200
