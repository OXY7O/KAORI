# KAORI application site (the root kaori.cloud is reserved for the independent website).
# Copy to /opt/shared-edge/config/sites/kaori.env only when bootstrapping manually.
EDGE_DOMAIN=app.kaori.cloud
EDGE_UPSTREAM=kaori-web
EDGE_UPSTREAM_PORT=5000
EDGE_TLS=true
EDGE_HEALTH_PATH=/health/ready
EDGE_WEBSOCKET=false
EDGE_CLIENT_MAX_BODY_SIZE=25m
