# KAORI integration examples — safe demo defaults only.
# Copy to example/.env and change values only for your disposable demo environment.

PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.33.1
THANOS_IMAGE=quay.io/thanos/thanos:v0.42.4
MINIO_IMAGE=minio/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
THANOS_QUERY_PORT=10902

MINIO_ROOT_USER=kaori-demo
MINIO_ROOT_PASSWORD=kaori-demo-secret
MINIO_THANO_BUCKET=thanos

# Optional disposable GitHub runner example. Never commit a real token.
RUNNER_VERSION=2.337.0
GITHUB_RUNNER_URL=https://github.com/example/example
GITHUB_RUNNER_TOKEN=
GITHUB_RUNNER_NAME=kaori-demo-runner
GITHUB_RUNNER_LABELS=kaori-demo,linux,x64
DOCKER_GID=998
