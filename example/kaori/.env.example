# Copy to .env and replace the admitted release identity values before start.
# Use the exact RC image/tag or immutable digest produced from admitted kaori/staging.
KAORI_IMAGE=docker.io/oxy7o/kaori:v0.0.0-rc.0
APP_VERSION=0.0.0-rc.0
APP_BUILD_SHA=0000000000000000000000000000000000000000
APP_BUILD_DATE=2026-01-01T00:00:00Z
KAORI_PORT=5000

# Disposable laptop-only values. Do not reuse outside this example.
SECRET_KEY=local-example-change-me-please-00000000000000000000
INTEGRATION_CREDENTIAL_KEY=local-example-integration-key-change-me-000000
POSTGRES_PASSWORD=kaori-local
REDIS_PASSWORD=kaori-local
ADMIN_USERNAME=super
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

KAORI_PUBLIC_BASE_URL=http://localhost:5000
TRUSTED_HOSTS=localhost,127.0.0.1
PROXY_FIX_ENABLED=false

# All other application settings intentionally inherit reviewed production-image defaults.
# This example overrides only release identity, disposable local credentials, networking,
# and bootstrap values required to run an admitted RC image on a laptop.
